root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{py,sh}]
indent_style = space
indent_size = 4

# cmd.exe can misparse parenthesized blocks with LF line endings
[*.bat]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.md]
indent_style = space
trim_trailing_whitespace = false

# Vendored PetitZip, kept as published
[setup/zip.mjs]
insert_final_newline = unset
trim_trailing_whitespace = unset
